{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@tanstack/react-query": "^5.101.0",
    "@types/jest": "29.5.14",
    "expo": "~56.0.11",
    "expo-camera": "~56.0.8",
    "expo-router": "~56.2.10",
    "expo-secure-store": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.5",
    "react": "19.2.3",
    "react-native": "0.85.3"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.0",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit"
